// KAKELBOLAGET THEME JAVASCRIPT

jQuery(document).ready(function($) {
    
    // Wall Calculator Modal
    function initWallCalculator() {
        const modal = $('#wall-calculator-modal');
        const closeBtn = $('.close');
        const calcBtn = $('.wall-calculator-trigger');
        
        // Open modal
        $(document).on('click', '.wall-calculator-trigger, .pricing-calculator', function(e) {
            e.preventDefault();
            modal.show();
            $('body').addClass('modal-open');
        });
        
        // Close modal
        closeBtn.on('click', function() {
            modal.hide();
            $('body').removeClass('modal-open');
        });
        
        // Close on background click
        modal.on('click', function(e) {
            if (e.target === modal[0]) {
                modal.hide();
                $('body').removeClass('modal-open');
            }
        });
        
        // Tab switching
        $('.tab-btn').on('click', function() {
            $('.tab-btn').removeClass('active');
            $(this).addClass('active');
        });
        
        // Calculator functionality
        $('#calc-width, #calc-height, #calc-unit').on('input change', function() {
            calculateArea();
        });
        
        function calculateArea() {
            const width = parseFloat($('#calc-width').val()) || 0;
            const height = parseFloat($('#calc-height').val()) || 0;
            const unit = $('#calc-unit').val();
            
            let area = 0;
            if (unit === 'cm') {
                area = (width * height) / 10000; // Convert cm² to m²
            } else {
                area = width * height; // Already in m²
            }
            
            $('#calc-total').val(area.toFixed(2));
            $('#calc-result').text(area.toFixed(2));
        }
        
        // Use calculation button
        $('#use-calculation').on('click', function() {
            const area = parseFloat($('#calc-result').text()) || 0;
            // Update product page with calculated area
            $('.quantity-input').val(Math.ceil(area));
            modal.hide();
            $('body').removeClass('modal-open');
        });
    }
    
    // Product Image Gallery
    function initProductGallery() {
        $('.product-thumbnails img').on('click', function() {
            const newSrc = $(this).attr('src');
            $('.product-main-image img').attr('src', newSrc);
            $('.product-thumbnails img').removeClass('active');
            $(this).addClass('active');
        });
        
        // Zoom functionality
        $('.product-main-image').on('mousemove', function(e) {
            const $this = $(this);
            const offset = $this.offset();
            const x = e.pageX - offset.left;
            const y = e.pageY - offset.top;
            const xPercent = (x / $this.width()) * 100;
            const yPercent = (y / $this.height()) * 100;
            
            $this.find('img').css('transform-origin', `${xPercent}% ${yPercent}%`);
        });
    }
    
    // Product Options/Variations
    function initProductOptions() {
        $('.pricing-option').on('click', function() {
            $('.pricing-option').removeClass('active');
            $(this).addClass('active');
            
            const price = $(this).find('.pricing-option-price').text();
            $('.price-main').text(price);
        });
        
        // Quantity controls
        $('.quantity-plus').on('click', function() {
            const input = $(this).siblings('.quantity-input');
            const currentVal = parseInt(input.val()) || 0;
            input.val(currentVal + 1);
        });
        
        $('.quantity-minus').on('click', function() {
            const input = $(this).siblings('.quantity-input');
            const currentVal = parseInt(input.val()) || 0;
            if (currentVal > 1) {
                input.val(currentVal - 1);
            }
        });
    }
    
    // Wishlist functionality
    function initWishlist() {
        $(document).on('click', '.heart-icon, .favorites-btn', function(e) {
            e.preventDefault();
            e.stopPropagation();
            
            const $this = $(this);
            const productId = $this.closest('.product-card, .product-details').data('product-id');
            
            if ($this.hasClass('favorited')) {
                // Remove from favorites
                $this.removeClass('favorited');
                $this.find('i').text('♡');
                removeFromWishlist(productId);
            } else {
                // Add to favorites
                $this.addClass('favorited');
                $this.find('i').text('♥');
                addToWishlist(productId);
            }
        });
        
        function addToWishlist(productId) {
            $.ajax({
                url: kakelbolaget_ajax.ajax_url,
                type: 'POST',
                data: {
                    action: 'add_to_wishlist',
                    product_id: productId,
                    nonce: kakelbolaget_ajax.nonce
                },
                success: function(response) {
                    if (response.success) {
                        showNotification('Produkt tillagd i favoriter!', 'success');
                    }
                }
            });
        }
        
        function removeFromWishlist(productId) {
            $.ajax({
                url: kakelbolaget_ajax.ajax_url,
                type: 'POST',
                data: {
                    action: 'remove_from_wishlist',
                    product_id: productId,
                    nonce: kakelbolaget_ajax.nonce
                },
                success: function(response) {
                    if (response.success) {
                        showNotification('Produkt borttagen från favoriter!', 'info');
                    }
                }
            });
        <?php
/**
